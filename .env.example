"""
.env Template
Copy this to .env and fill in your configuration
"""

# ComfyUI Configuration
COMFYUI_SERVER_URL=http://127.0.0.1:8188
COMFYUI_WEBSOCKET_URL=ws://127.0.0.1:8188/ws

# Model Configuration
PRIMARY_MODEL=realisticVisionV60B1_v60B1VAE.safetensors
VAE_MODEL=vae-ft-mse-840000-ema-pruned.safetensors

# Generation Parameters
IMAGE_WIDTH=768
IMAGE_HEIGHT=432
IMAGE_STEPS=30
GUIDANCE_SCALE=7.5

# Batch Processing
MAX_CONCURRENT_RENDERS=1
MAX_RETRIES=3

# Optional: LLM Integration
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here

# Optional: Google Colab
# COLAB_ENABLED=false
# DRIVE_OUTPUT_DIR=/content/drive/MyDrive/DirectorAI
